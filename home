
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Richard Wix Creative Expert - Professional website design, business websites, landing pages and digital solutions.">
  <title>Richard Wix Creative | Professional Website Designer</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --navy: #101d35;
      --navy-light: #1b2d4b;
      --gold: #d5ad65;
      --gold-light: #f0d7a5;
      --white: #ffffff;
      --background: #f7f8fa;
      --text: #263449;
      --muted: #68758a;
      --border: #e6eaf0;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      color: var(--text);
      background: var(--white);
      line-height: 1.7;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: min(1120px, 90%);
      margin: auto;
    }

    .topbar {
      background: var(--navy);
      color: #dbe3ef;
      font-size: 13px;
      padding: 9px 0;
    }

    .topbar .container {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
    }

    header {
      background: rgba(255,255,255,.97);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(12px);
    }

    nav {
      min-height: 82px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 25px;
    }

    .logo {
      font-family: 'Manrope', sans-serif;
      font-size: 21px;
      font-weight: 800;
      color: var(--navy);
      line-height: 1.2;
    }

    .logo span {
      color: var(--gold);
    }

    .logo small {
      display: block;
      font-size: 10px;
      letter-spacing: 2px;
      color: var(--muted);
      font-weight: 600;
      margin-top: 5px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 30px;
      list-style: none;
      font-size: 14px;
      font-weight: 600;
    }

    .nav-links a:hover {
      color: #b48742;
    }

    .nav-cta, .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--gold);
      color: var(--navy);
      padding: 13px 22px;
      border-radius: 5px;
      font-weight: 800;
      font-size: 14px;
      transition: .25s ease;
    }

    .nav-cta:hover, .button:hover {
      background: var(--gold-light);
      transform: translateY(-2px);
    }

    .menu-toggle {
      display: none;
      border: 0;
      background: none;
      font-size: 28px;
      color: var(--navy);
      cursor: pointer;
    }

    .hero {
      background:
        radial-gradient(circle at 85% 20%, rgba(213,173,101,.17), transparent 30%),
        linear-gradient(115deg, #101d35 0%, #1b2d4b 100%);
      color: var(--white);
      padding: 105px 0 110px;
      overflow: hidden;
    }

    .hero-content {
      max-width: 780px;
    }

    .eyebrow {
      color: var(--gold-light);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 22px;
    }

    .hero h1 {
      font-family: 'Manrope', sans-serif;
      font-size: clamp(38px, 6vw, 67px);
      line-height: 1.12;
      letter-spacing: -2px;
      margin-bottom: 25px;
    }

    .hero h1 span {
      color: var(--gold-light);
    }

    .hero p {
      max-width: 640px;
      color: #d3dce9;
      font-size: 17px;
      margin-bottom: 34px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 15px;
    }

    .button-outline {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      border: 1px solid rgba(255,255,255,.45);
      color: white;
      padding: 12px 22px;
      border-radius: 5px;
      font-weight: 700;
      font-size: 14px;
      transition: .25s;
    }

    .button-outline:hover {
      background: white;
      color: var(--navy);
    }

    .trust-strip {
      background: #f3f5f8;
      padding: 25px 0;
    }

    .trust-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
    }

    .trust-item {
      color: var(--navy);
      font-weight: 700;
      font-size: 14px;
    }

    .trust-item span {
      color: #b48742;
      margin-right: 8px;
    }

    section {
      padding: 90px 0;
    }

    .section-heading {
      max-width: 680px;
      margin-bottom: 45px;
    }

    .section-label {
      color: #b48742;
      text-transform: uppercase;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 2.5px;
      margin-bottom: 12px;
    }

    .section-heading h2 {
      font-family: 'Manrope', sans-serif;
      color: var(--navy);
      font-size: clamp(30px, 4vw, 43px);
      line-height: 1.2;
      letter-spacing: -1px;
      margin-bottom: 16px;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 16px;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 65px;
      align-items: center;
    }

    .about-panel {
      background: var(--navy);
      color: white;
      border-radius: 10px;
      padding: 42px;
      min-height: 310px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      position: relative;
      overflow: hidden;
    }

    .about-panel::before {
      content: "RW";
      position: absolute;
      top: 5px;
      right: 15px;
      font-family: 'Manrope', sans-serif;
      font-size: 150px;
      font-weight: 800;
      color: rgba(255,255,255,.055);
    }

    .about-panel h3 {
      font-family: 'Manrope', sans-serif;
      font-size: 27px;
      position: relative;
    }

    .about-panel p {
      color: #d1dbea;
      margin-top: 12px;
      position: relative;
    }

    .about-copy p {
      color: var(--muted);
      margin-bottom: 18px;
    }

    .check-list {
      list-style: none;
      margin: 22px 0;
    }

    .check-list li {
      margin: 12px 0;
      color: var(--navy);
      font-weight: 600;
    }

    .check-list li::before {
      content: "✓";
      color: #b48742;
      font-weight: 800;
      margin-right: 11px;
    }

    .services {
      background: var(--background);
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .service-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 32px 27px;
      transition: .3s ease;
    }

    .service-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 35px rgba(16,29,53,.09);
      border-color: var(--gold);
    }

    .service-icon {
      width: 50px;
      height: 50px;
      background: #f6efdf;
      color: #9a7135;
      border-radius: 7px;
      display: grid;
      place-items: center;
      font-size: 23px;
      margin-bottom: 23px;
    }

    .service-card h3 {
      font-family: 'Manrope', sans-serif;
      font-size: 19px;
      color: var(--navy);
      margin-bottom: 12px;
    }

    .service-card p {
      font-size: 14px;
      color: var(--muted);
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 25px;
    }

    .process-step {
      border-top: 2px solid var(--gold);
      padding-top: 22px;
    }

    .step-number {
      font-family: 'Manrope', sans-serif;
      font-size: 32px;
      font-weight: 800;
      color: #c49a55;
      margin-bottom: 10px;
    }

    .process-step h3 {
      color: var(--navy);
      font-size: 17px;
      margin-bottom: 8px;
    }

    .process-step p {
      color: var(--muted);
      font-size: 14px;
    }

    .cta {
      background: var(--navy);
      color: white;
      text-align: center;
      padding: 85px 0;
    }

    .cta h2 {
      font-family: 'Manrope', sans-serif;
      font-size: clamp(30px, 4vw, 43px);
      line-height: 1.2;
      max-width: 700px;
      margin: 0 auto 18px;
    }

    .cta p {
      color: #cbd5e3;
      max-width: 590px;
      margin: 0 auto 30px;
    }

    .contact {
      background: var(--background);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 45px;
      align-items: center;
    }

    .contact-info h3 {
      color: var(--navy);
      font-family: 'Manrope', sans-serif;
      font-size: 25px;
      margin-bottom: 12px;
    }

    .contact-info p {
      color: var(--muted);
      margin-bottom: 20px;
    }

    .contact-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 30px;
    }

    .contact-card h3 {
      color: var(--navy);
      font-family: 'Manrope', sans-serif;
      margin-bottom: 12px;
    }

    .contact-card p {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 22px;
    }

    footer {
      background: #0b1629;
      color: #c6d0df;
      padding: 35px 0;
      font-size: 13px;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 15px;
    }

    .footer-content strong {
      color: white;
    }

    .whatsapp-float {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 200;
      background: #20bd5a;
      color: white;
      padding: 14px 19px;
      border-radius: 50px;
      font-size: 14px;
      font-weight: 800;
      box-shadow: 0 6px 20px rgba(0,0,0,.2);
      transition: .25s;
    }

    .whatsapp-float:hover {
      transform: translateY(-4px);
      background: #159b48;
    }

    @media(max-width: 850px) {
      .menu-toggle {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 82px;
        left: 0;
        right: 0;
        background: white;
        padding: 25px 5%;
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
        border-bottom: 1px solid var(--border);
      }

      .nav-links.active {
        display: flex;
      }

      .nav-cta {
        display: none;
      }

      .about-grid, .contact-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .service-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .process-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media(max-width: 560px) {
      .topbar .container {
        justify-content: center;
        text-align: center;
      }

      .hero {
        padding: 75px 0;
      }

      .hero h1 {
        letter-spacing: -1px;
      }

      section {
        padding: 65px 0;
      }

      .service-grid, .process-grid {
        grid-template-columns: 1fr;
      }

      .about-panel {
        padding: 30px;
      }

      .trust-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      .whatsapp-float {
        right: 15px;
        bottom: 15px;
      }
    }
  </style>
</head>

<body>

  <div class="topbar">
    <div class="container">
      <span>Professional Website Design & Digital Solutions</span>
      <span>Available for New Projects</span>
    </div>
  </div>

  <header>
    <nav class="container">
